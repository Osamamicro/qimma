<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Local speech-to-text for Qimma phones (ADR-015). Windows only: Media Foundation decodes the
       phone's AAC/M4A recordings without FFmpeg. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>qimma-stt</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same versions as the sister project Mudawwin, so they come from the local NuGet cache. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- GPU through Vulkan (works on integrated Intel/AMD graphics); falls back to the CPU runtime. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

</Project>
