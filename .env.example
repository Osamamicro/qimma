# Optional AI writing scoring (ADR-008, ADR-014), open-weight models only. Copy to .env.local
# (gitignored). Leave everything unset to score on the device only.

# Local (recommended): an Ollama server on this machine. From the Android emulator use
# http://10.0.2.2:11434. For the GitHub Pages site, start Ollama with
# OLLAMA_ORIGINS=https://osamamicro.github.io so the browser may call it.
EXPO_PUBLIC_LOCAL_LLM_URL=http://localhost:11434
EXPO_PUBLIC_LOCAL_LLM_MODEL=qwen3:8b

# Hosted (optional): the score-writing Supabase Edge Function, which calls any OpenAI-compatible
# open-model provider set by its LLM_BASE_URL / LLM_MODEL / LLM_API_KEY secrets. Both values below
# end up in the client bundle; the provider key never does.
# EXPO_PUBLIC_SCORING_API_URL=https://<project-ref>.supabase.co/functions/v1/score-writing
# EXPO_PUBLIC_SUPABASE_KEY=<supabase anon key>

# Optional speech-to-text for speaking tasks on phones and the emulator (ADR-015): the local
# qimma-stt server in tools/stt-server (Whisper). Emulator: http://10.0.2.2:8178; a phone on the
# same Wi-Fi: http://<PC LAN address>:8178. Leave unset to keep self-review on phones.
# EXPO_PUBLIC_LOCAL_STT_URL=http://10.0.2.2:8178
