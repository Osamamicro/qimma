# Optional AI writing scoring (ADR-008). Leave unset to score on the device only.
# Copy to .env.local (gitignored). Both values end up in the client bundle, so never put a
# model API key here: ANTHROPIC_API_KEY lives only in the Supabase function secrets.
EXPO_PUBLIC_SCORING_API_URL=https://<project-ref>.supabase.co/functions/v1/score-writing
EXPO_PUBLIC_SUPABASE_KEY=<supabase publishable key>
